[Desktop Entry]
Name=SirverData
Comment=SirverData Modern Real-time Chat & Workspace
Exec=sirverdata %U
Icon=sirverdata
Terminal=false
Type=Application
Categories=Network;InstantMessaging;Chat;AudioVideo;
Keywords=chat;voice;messaging;sirverdata;workspace;
StartupWMClass=sirverdata
MimeType=x-scheme-handler/sirver;
