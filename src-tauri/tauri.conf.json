{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SirverData",
  "version": "1.0.1",
  "identifier": "top.sirverdata.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SirverData",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "desktop-updater"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1",
          "librsvg2-2",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-pipewire"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRTY4NzA4RDNBQzVBMzEKUldTZm0wY01YclJ5VWhDdk9iTEpXWHJrdlV3VSttOUlQWUt3VktlWHQ1dFd2dkd6K3lhK1lVdz0K",
      "endpoints": [
        "https://sirverdata.top/api/updates/{{target}}/{{arch}}/{{current_version}}",
        "https://raw.githubusercontent.com/Simlfe/SirverData/main/updates/latest.json"
      ]
    }
  }
}
