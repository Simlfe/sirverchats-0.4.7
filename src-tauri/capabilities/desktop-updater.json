{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-updater",
  "description": "Desktop-only permissions for the in-place updater and restart controls",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows",
    "linux",
    "macOS"
  ],
  "permissions": [
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "process:allow-restart"
  ]
}
